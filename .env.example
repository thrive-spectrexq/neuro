# =============================================================================
# Neuro — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit real keys to .env — it is gitignored.
# All AI provider keys are optional — Neuro works fully offline.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
NEURO_ENV=development                          # development | staging | production
NEURO_SECRET_KEY=                              # REQUIRED in production: min 32 chars. Generate: openssl rand -hex 32

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# SQLite (default — no setup required)
DATABASE_URL=sqlite+aiosqlite:///./neuro.db
# PostgreSQL (uncomment to use)
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/neuro

# -----------------------------------------------------------------------------
# Redis (task queue & cache)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Vector Database (ChromaDB)
# -----------------------------------------------------------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8001

# -----------------------------------------------------------------------------
# AI Providers (all optional — set API key to enable)
# -----------------------------------------------------------------------------
# Local AI via Ollama (no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Cloud AI providers
OPENAI_API_KEY=                                # Optional: enables GPT-4o
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=                             # Optional: enables Claude
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=                                # Optional: enables Gemini

# -----------------------------------------------------------------------------
# Embedding Model
# -----------------------------------------------------------------------------
# Local: all-MiniLM-L6-v2 (default, no API key needed)
# Cloud: text-embedding-3-small (requires OPENAI_API_KEY)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# Security & TLS
# -----------------------------------------------------------------------------
ENFORCE_HTTPS=false                            # Set true in production
ACCESS_TOKEN_EXPIRE_MINUTES=1440               # JWT expiry (default: 24 hours)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO                                 # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=text                                # text | json (json recommended for production)
SENTRY_DSN=                                    # Optional: Sentry error reporting DSN

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_DEFAULT=60                          # Requests per minute (default endpoints)
RATE_LIMIT_AI=30                               # Requests per minute (AI endpoints)
RATE_LIMIT_AUTH=10                              # Requests per minute (auth endpoints)
